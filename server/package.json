{
  "name": "@klinikatop/server",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node -e \"require('fs').copyFileSync('src/db/schema.sql','dist/server/src/db/schema.sql')\"",
    "start": "node dist/server/src/index.js",
    "seed": "tsx src/db/seed.ts",
    "grant": "tsx src/db/grant.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx src/test/run.ts",
    "test:http": "bash src/test/http.sh",
    "seed:demo": "tsx src/db/seedDemo.ts",
    "admin:create": "tsx src/scripts/createAdmin.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "better-sqlite3": "^11.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.11",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
