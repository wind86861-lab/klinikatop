# ─────────────────────────────────────────────────────────────
# Shifo — muhit o'zgaruvchilari
#
# Autentifikatsiyaning YAGONA yo'li — Telegram imzosi. Imzosiz
# kirish yo'q, shuning uchun bot tokenisiz server ishga tushmaydi.
# ─────────────────────────────────────────────────────────────

# MAJBURIY. @BotFather dan olinadi.
TELEGRAM_BOT_TOKEN=

# Mini App joylashgan HTTPS manzil (Telegram faqat HTTPS'ni qabul qiladi)
WEBAPP_URL=https://shifo.example.uz

# CORS: vergul bilan ajratilgan domenlar. Bo'sh bo'lsa faqat
# Origin'siz so'rovlar (Telegram WebView) o'tadi.
CORS_ORIGINS=https://shifo.example.uz

NODE_ENV=production
PORT=8791
HOST=127.0.0.1
DATABASE_PATH=/var/lib/shifo/shifo.db

# AI. Berilmasa lokal heuristika ishlaydi (sifati pastroq).
ANTHROPIC_API_KEY=

# Biznes qoidalari — bularni admin panelidan ham o'zgartirish mumkin
COMMISSION_PERCENT=5
REQUEST_TTL_HOURS=24
MAX_ACTIVE_REQUESTS_PER_PATIENT=3
AUTO_CONFIRM_DAYS=14
TRIAL_MONTHS=6
